# Environment configuration for topographical-tensors
# Copy to .env if overriding defaults (never commit .env)

# External dataset, checkpoint, and telemetry staging root
TOPO_DATA_DIR=./data

# Native Stockfish binary path (auto-detected via PATH if omitted)
STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# PyTorch MPS fallback mode (1 = enabled on Apple Silicon)
PYTORCH_ENABLE_MPS_FALLBACK=1

# Default random seed for deterministic reproduction
TOPO_GLOBAL_SEED=42
